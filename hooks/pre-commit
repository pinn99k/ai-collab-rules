#!/bin/sh
# ai-collab 커밋 훅. 품질 경보는 경고만 한다. explain-back 대기가 한도를 넘을 때만 커밋을 막는다.
DIR=$(dirname "$0")
# Windows에서 파이프 출력이 cp949가 되어 한글이 깨지는 것을 막는다
export PYTHONIOENCODING=utf-8
status=0
for p in python3 python py; do
  if command -v "$p" >/dev/null 2>&1 && "$p" -c "" >/dev/null 2>&1; then
    "$p" "$DIR/quality_check.py"
    status=$?
    break
  fi
done
exit $status
